{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with roles and status",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "usuario": { "type": "string" },
        "pin": { "type": "string" },
        "perfil": { "type": "string", "enum": ["admin", "comum", "kds"] },
        "ativo": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["nome", "usuario", "perfil", "ativo"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "descricao": { "type": "string" },
        "preco": { "type": "number" },
        "estoque": { "type": "number" },
        "categoria": { "type": "string" },
        "ativo": { "type": "boolean" },
        "codigo": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["nome", "preco", "estoque", "ativo"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A completed or pending sale/pedido",
      "type": "object",
      "properties": {
        "usuario_id": { "type": "string" },
        "operador_nome": { "type": "string" },
        "status": { "type": "string", "enum": ["pago", "pendente", "cancelado"] },
        "valor_total": { "type": "number" },
        "valor_recebido": { "type": "number" },
        "troco": { "type": "number" },
        "forma_pagamento": { "type": "string" },
        "created_at": { "type": "string" },
        "cliente_nome": { "type": "string" },
        "pixInteractionId": { "type": "string" }
      },
      "required": ["status", "valor_total", "forma_pagamento", "created_at"]
    },
    "SaleItem": {
      "title": "SaleItem",
      "description": "Item belonging to a sale",
      "type": "object",
      "properties": {
        "produto_id": { "type": "string" },
        "nome": { "type": "string" },
        "quantidade": { "type": "number" },
        "preco_unitario": { "type": "number" },
        "subtotal": { "type": "number" }
      },
      "required": ["produto_id", "quantidade", "preco_unitario", "subtotal"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global config and integrations",
      "type": "object",
      "properties": {
        "cantinaName": { "type": "string" },
        "mercadoPagoToken": { "type": "string" },
        "mercadoPagoPublicKey": { "type": "string" }
      }
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer registered via reservation or sales",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "telefone": { "type": "string" },
        "telefone_limpo": { "type": "string" },
        "total_pedidos": { "type": "number" },
        "total_gasto": { "type": "number" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "origem": { "type": "string" }
      },
      "required": ["nome", "telefone", "telefone_limpo"]
    },
    "CashShift": {
      "title": "CashShift",
      "description": "Cash register shift with opening, movements, outflows, and closing audit",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["aberto", "fechado"] },
        "aberto_em": { "type": "string" },
        "aberto_por_nome": { "type": "string" },
        "aberto_por_id": { "type": "string" },
        "valor_abertura": { "type": "number" },
        "fechado_em": { "type": "string" },
        "fechado_por_nome": { "type": "string" },
        "fechado_por_id": { "type": "string" },
        "valor_fechamento_informado": { "type": "number" },
        "valor_fechamento_calculado": { "type": "number" },
        "diferenca": { "type": "number" },
        "observacoes_fechamento": { "type": "string" },
        "total_sangrias": { "type": "number" },
        "total_suprimentos": { "type": "number" },
        "total_saidas": { "type": "number" }
      },
      "required": ["status", "aberto_em", "aberto_por_nome", "valor_abertura"]
    },
    "CashOutflow": {
      "title": "CashOutflow",
      "description": "Cash outflow / expense entry from the cash register",
      "type": "object",
      "properties": {
        "shift_id": { "type": "string" },
        "categoria": { "type": "string", "maxLength": 60 },
        "valor": { "type": "number" },
        "motivo": { "type": "string", "maxLength": 200 },
        "data": { "type": "string" },
        "operador_nome": { "type": "string", "maxLength": 80 },
        "operador_id": { "type": "string", "maxLength": 80 }
      },
      "required": ["categoria", "valor", "motivo", "data", "operador_nome"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and RBAC."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products catalog."
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Sale registries. Items are stored as array or subcollection."
    },
    "/sales/{saleId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/SaleItem" },
      "description": "Items of a specific sale."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "App settings like MP token"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Registered customer records with contact and order history."
    },
    "/cash_shifts/{shiftId}": {
      "schema": { "$ref": "#/entities/CashShift" },
      "description": "Cash register shift records."
    },
    "/cash_outflows/{outflowId}": {
      "schema": { "$ref": "#/entities/CashOutflow" },
      "description": "Cash register outflow and expense entries."
    }
  }
}
